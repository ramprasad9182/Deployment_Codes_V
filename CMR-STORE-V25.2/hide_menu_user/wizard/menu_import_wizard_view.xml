<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="view_menu_import_wizard_form" model="ir.ui.view">

        <field name="name">menu.import.wizard.form</field>

        <field name="model">menu.import.wizard</field>

        <field name="arch" type="xml">

            <form string="Import Hidden Menus">

                <group>

<!--                    <field name="user_id" readonly="1"/>-->
                    <field name="user_ids" widget="many2many_tags"/>

                    <field name="file" filename="file_name"/>

                    <field name="file_name" invisible="1"/>

                </group>

                <footer>

                    <button name="action_import_menus"
                            string="Import"
                            type="object"
                            class="btn-primary"/>

                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>

                </footer>

            </form>

        </field>

    </record>

</odoo>