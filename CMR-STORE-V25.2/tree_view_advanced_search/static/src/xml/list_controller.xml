<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="ListViewSearchToggle" t-inherit="web.ListView" t-inherit-mode="extension">
        <xpath expr="//t[@t-set-slot='control-panel-create-button']" position="inside">
            <button type="button"
                    class="btn btn-secondary ms-2"
                    title="Show or hide the advanced search filters"
                    t-on-click="toggleFilterRow">
<!--                <t t-esc="filterRowState.show ? 'Hide Filters' : 'Show Filters'"/>-->
                Show/Hide
            </button>
        </xpath>
    </t>
</templates>