<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.Navbar" t-inherit-mode="extension">
        <xpath expr="//div[@t-on-click='openMenu']" position="attributes">
            <attribute name="t-att-class">{'d-none': isPaymentScreen}</attribute>
        </xpath>
        <xpath expr="//div[@t-on-click='closeMenu']" position="attributes">
            <attribute name="t-att-class">{'d-none': isPaymentScreen}</attribute>
        </xpath>
    </t>
</templates>