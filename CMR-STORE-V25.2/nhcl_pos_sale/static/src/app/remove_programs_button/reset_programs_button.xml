<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="nhcl_pos_sale.RemoveProgramsButton">
        <t t-if="this.pos.get_cashier()?.allow_remove_programs || this.pos.user?.allow_remove_programs">
            <button class="control-button btn btn-light rounded-0 fw-bolder" t-on-click="() => this.click()">
                <i class="fa fa-trash me-1"></i>
                <span> </span>
                <span>Remove Programs</span>
            </button>
        </t>
    </t>

</templates>
