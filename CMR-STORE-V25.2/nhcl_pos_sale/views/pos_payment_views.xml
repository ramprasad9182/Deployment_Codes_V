<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_payment_inherit_nhcl" model="ir.ui.view">
        <field name="name">pos.make.payment.form.inherit.nhcl</field>
        <field name="model">pos.make.payment</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_payment"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_method_id']" position="attributes">
                <attribute name="domain">[('config_ids', 'in', config_id), ('is_cash_count', '=', True)]</attribute>
            </xpath>
        </field>
    </record>
</odoo>
