    <record id="action_sync_price_from_remote" model="ir.actions.server">
    <field name="name">Sync Price From HO</field>
    <field name="model_id" ref="stock.model_stock_lot"/>
    <field name="binding_model_id" ref="stock.model_stock_lot"/>
    <field name="binding_view_types">list</field>
    <field name="state">code</field>
    <field name="code">action = records.sync_price_from_remote()</field>
        <field name="groups_id" eval="[(4, ref('base.group_system'))]"/>
</record>
