<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cmr_loyalty_rule_view_form_view" model="ir.ui.view">
        <field name="name">loyalty.rule.view.form.inherit</field>
        <field name="model">loyalty.rule</field>
        <field name="inherit_id" ref="loyalty.loyalty_rule_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet/button[@name='reset_to_filters']" position="after">
                <button name="action_export_filtered_barcodes"
                        string="Export Filtered Barcodes"
                        type="object"
                        class="btn-primary"/>
            </xpath>
        </field>
    </record>

    <record id="action_apply_loyalty_rules" model="ir.actions.server">
        <field name="name">Update Serial Nos</field>
        <field name="model_id" ref="loyalty.model_loyalty_program"/>
        <field name="binding_model_id" ref="loyalty.model_loyalty_program"/>
        <field name="binding_view_types">tree,form</field>
        <field name="state">code</field>
        <field name="groups_id" eval="[Command.link(ref('point_of_sale.group_pos_manager'))]"/>
        <field name="code">
        if records:
            records.action_apply_loyalty_rules()</field>
    </record>

    <record id="view_loyalty_program_form_inherit_apply_promo" model="ir.ui.view">
    <field name="name">loyalty.program.form.inherit.apply.promo</field>
    <field name="model">loyalty.program</field>
    <field name="inherit_id" ref="loyalty.loyalty_program_view_form"/>
    <field name="arch" type="xml">
        <xpath expr="//header" position="inside">
            <button name="action_apply_promo"
                    type="object"
                    string="Apply Promo"
                    class="btn-primary"
                     invisible="promo_type != 'in_house' or not active"/>
        </xpath>

    </field>
</record>

</odoo>
