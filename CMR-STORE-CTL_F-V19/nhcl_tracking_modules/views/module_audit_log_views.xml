<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_module_audit_log_tree" model="ir.ui.view">
        <field name="name">module.audit.log.tree</field>
        <field name="model">module.audit.log</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0" delete="0">
                <field name="create_date"/>
                <field name="module_name"/>
                <field name="action"/>
                <field name="user_id"/>
                <field name="user_login"/>
                <field name="client_ip"/>
                <field name="database_name"/>
            </tree>
        </field>
    </record>

    <record id="view_module_audit_log_form" model="ir.ui.view">
        <field name="name">module.audit.log.form</field>
        <field name="model">module.audit.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="module_name"/>
                            <field name="action"/>
                            <field name="user_id"/>
                            <field name="user_login"/>
                        </group>

                        <group>
                            <field name="client_ip"/>
                            <field name="server_ip"/>
                            <field name="hostname"/>
                            <field name="database_name"/>
                        </group>
                    </group>

                    <group>
                        <field name="module_state"/>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_module_audit_log" model="ir.actions.act_window">
        <field name="name">Module Audit Logs</field>
        <field name="res_model">module.audit.log</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="menu_module_audit_log"
        name="Module Audit Logs"
        parent="base.menu_administration"
        action="action_module_audit_log"
        groups="base.group_no_one"
        sequence="999"/>
</odoo>